[Unit]
Description=IMAP Email Hosting Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/imap/backend
Environment="PATH=/opt/imap/backend/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/imap/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 7892 --workers 1
Restart=always
RestartSec=10

StandardOutput=append:/var/log/imap-backend/access.log
StandardError=append:/var/log/imap-backend/error.log

[Install]
WantedBy=multi-user.target
