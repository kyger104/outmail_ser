[Unit]
Description=IMAP Email Hosting Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/imap-backend
Environment="PATH=/opt/imap-backend/.venv/bin"
ExecStart=/opt/imap-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# 日志
StandardOutput=append:/var/log/imap-backend/access.log
StandardError=append:/var/log/imap-backend/error.log

[Install]
WantedBy=multi-user.target
